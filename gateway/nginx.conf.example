server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name realmwatch.example.com;
    ssl_certificate /tls/fullchain.pem;
    ssl_certificate_key /tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://auth:4180;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port 8443;
        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
    }
}
# Only reachable inside this dedicated Docker network, after OAuth validation.
server {
    listen 8080;
    server_name _;
    location / {
        proxy_pass http://host.docker.internal:8088;
        proxy_set_header X-Realmwatch-Upstream __UPSTREAM_SECRET__;
        proxy_set_header Host realmwatch.example.com;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
    }
}
